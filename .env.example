# ============================================================
# held — environment template
#
# Copy to .env and fill in. .env is gitignored and must never
# be committed; this file is committed and must never contain
# a real value.
#
# Public, non-secret facts — parcel tracking numbers, deployed
# contract addresses, courier codes — belong in committed
# config, not here. This file is for secrets and for values
# that differ between machines and environments.
# ============================================================

# --- Delivery oracle: Ship24 -------------------------------
# Free tier: 10 shipments/month + 100 first-month bonus.
# Sent as: Authorization: Bearer apik_…
SHIP24_API_KEY=

# Unguessable path segment for the webhook URL, which is how the
# receiver rejects anything that is not the provider. Generate one
# with: node -e "console.log(crypto.randomUUID())"
# The receiver listens on /hooks/ship24/<this value>.
SHIP24_WEBHOOK_SECRET=

SHIP24_API_BASE=https://api.ship24.com/public/v1


# --- Chain: Base Sepolia -----------------------------------
CHAIN_ID=84532

# Optional. The protocol configuration below ships its own RPC
# endpoint, which is shared and rate-limited: fine for reads,
# not for anything that matters. Set your own to override it.
RPC_URL=

# Core SDK environment and config id.
# Confirm the exact config id from the protocol rather than
# guessing it — it encodes network + deployment version.
BOSON_ENV=testing
BOSON_CONFIG_ID=testing-84532-0

# Exchange token: an ERC-20 (USDC). Native currency is not
# usable — a meta-transaction cannot forward msg.value.
#
# Read this address from the dispute resolver's fee schedule.
# An offer is only valid if the two match exactly; do not copy
# it from a block explorer or from memory.
EXCHANGE_TOKEN_ADDRESS=0x036cbd53842c5426634e7929541ec2318f3dcf7e

# ⚠ A resolver id is only meaningful together with the config id
# above. The same number names unrelated resolvers on different
# configurations, including on the same chain - so never move
# this value between environments without checking it.
# See docs/specs/offer-model.md section 4.
DISPUTE_RESOLVER_ID=35


# --- Wallets (never committed, no exceptions) --------------
# Pre-provisioned accounts. The buyer holds the exchange token
# and no native currency: every buyer action is a signature
# relayed as a meta-transaction.
BUYER_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
DISPUTE_RESOLVER_PRIVATE_KEY=


# --- Meta-transaction relayer ------------------------------
# Every buyer action is a signature that somebody else submits
# and pays gas for. The protocol runs that relayer and ships its
# URL inside the configuration named by BOSON_CONFIG_ID, so the
# URL below is an override and may be left empty.
#
# The key and the protocol id are NOT optional. The SDK refuses
# to relay without a relayer URL, an API key and an API id: the
# call asserts on all three and throws before anything is sent.
# Set the two credentials together, or leave both empty.
#
# An API id is issued per contract and per method, and the one
# that matters is the PROTOCOL id: the purchase is signed
# against the protocol contract. Neither id carries to another
# configuration.
#
# EXCHANGE_TOKEN is optional and unusable on Base Sepolia.
# Relaying to a token means calling executeMetaTransaction on
# the token, and neither USDC deployed there implements it - so
# the buyer's allowance is granted once, as a direct
# transaction, by `npm run provision`. Leave it empty here; set
# it only on a chain whose token does implement the interface.
# See docs/chain.md.
#
# Verify with: npm run chain-check
META_TX_RELAYER_URL=
META_TX_RELAYER_API_KEY=
META_TX_RELAYER_API_ID_PROTOCOL=
META_TX_RELAYER_API_ID_EXCHANGE_TOKEN=


# --- AI: mediator and case clerk ---------------------------
# Provider choice is not yet settled; keys are provisioned so
# the decision costs nothing later.
#
# These components read evidence and propose a percentage.
# They are never given a credential or tool that can move
# funds - see CLAUDE.md.
ANTHROPIC_API_KEY=
MEDIATOR_MODEL=


# --- Runtime -----------------------------------------------
PORT=3000

# Where captured tracking events are written, relative to the repo
# root. Defaults to fixtures/events. These files are scrubbed on the
# way in and are meant to be committed.
EVENTS_DIR=fixtures/events

# Courier events name the places a parcel passed through, and a
# parcel's route ends at somebody's home. Captured locations are
# therefore redacted by default. Set to true only for addresses you
# are content to publish; postcodes are stripped either way.
RETAIN_LOCATIONS=false

# The tracker ids whose events the receiver accepts, comma-separated.
# REQUIRED: the receiver refuses to start without it, because an unset
# allowlist is not a narrower filter, it is no filter. The webhook path
# authenticates the caller but not the body, so anyone holding the URL
# can otherwise inject events for a parcel nobody registered - which a
# provider has already done to us once, in state delivered.
#
# Registering a parcel is therefore two steps: create the tracker, then
# add its id here. On the deployed host this is a Fly secret, and
# applying it restarts the machine - so do it before hand-over, not
# while the first events are arriving.
SHIP24_TRACKER_ALLOWLIST=

# Accept events for any tracker id, allowlist or not. Local
# development only: it is named in the startup banner every time.
ALLOW_ANY_TRACKER=false

# Public HTTPS origin of the deployed webhook receiver.
# Ship24 posts tracking events here, so it must be reachable
# from the internet - not a local tunnel.
PUBLIC_BASE_URL=

# Webhook secret for the deployed receiver on Fly (app: held-receiver).
# Fly stores secrets write-only, so this is the only copy outside Ship24.
FLY_WEBHOOK_SECRET=

# Where the watchdog keeps live state. Both are gitignored: the first
# holds exchange records, the second holds the buyer's pre-signed
# authorisations, which are bearer instruments and are secrets.
EXCHANGES_DIR=state/exchanges
AUTHORISATIONS_DIR=state/authorisations

# How long before a window closes the watchdog acts. Left unset, each
# is derived from the period it guards - 48h and 24h against the 7-day
# protocol floor. Both windows pay the other party if they lapse, which
# is why acting early is the safe direction.
#
# The lead is the only tunable: the protocol rejects any period under 7
# days, so a window cannot be shortened for testing. Calibrate the
# lead, not the window. A lead over half its period is a demonstration
# configuration, warns loudly at startup, and must not ship.
DISPUTE_RAISE_LEAD_MS=
ESCALATION_LEAD_MS=

# How often the sweep runs when not passed --once.
WATCHDOG_INTERVAL_MS=60000
