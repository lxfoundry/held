# ============================================================
# held — environment template
#
# Copy to .env and fill in. .env is gitignored and must never
# be committed; this file is committed and must never contain
# a real value.
#
# Public, non-secret facts — parcel tracking numbers, deployed
# contract addresses, courier codes — belong in committed
# config, not here. This file is for secrets and for values
# that differ between machines and environments.
# ============================================================

# --- Delivery oracle: Ship24 -------------------------------
# Free tier: 10 shipments/month + 100 first-month bonus.
# Sent as: Authorization: Bearer apik_…
SHIP24_API_KEY=

# Set only if webhook signature verification is enabled.
SHIP24_WEBHOOK_SECRET=

SHIP24_API_BASE=https://api.ship24.com/public/v1


# --- Chain: Base Sepolia -----------------------------------
CHAIN_ID=84532
RPC_URL=

# Core SDK environment and config id.
# Confirm the exact config id from the protocol rather than
# guessing it — it encodes network + deployment version.
BOSON_ENV=testing
BOSON_CONFIG_ID=

# Exchange token: an ERC-20 (USDC). Native currency is not
# usable — a meta-transaction cannot forward msg.value.
#
# Read this address from the dispute resolver's fee schedule.
# An offer is only valid if the two match exactly; do not copy
# it from a block explorer or from memory.
EXCHANGE_TOKEN_ADDRESS=

# The LX Foundry dispute resolver once registered.
# Fallback on Base Sepolia: 20 (accepts USDC at zero fee).
DISPUTE_RESOLVER_ID=


# --- Wallets (never committed, no exceptions) --------------
# Pre-provisioned accounts. The buyer holds the exchange token
# and no native currency: every buyer action is a signature
# relayed as a meta-transaction.
BUYER_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
DISPUTE_RESOLVER_PRIVATE_KEY=


# --- Meta-transaction relayer ------------------------------
# Used by relayMetaTransaction to submit on the buyer's behalf.
# Confirm the provider and whether a credential is needed at
# all when wiring the Core SDK.
META_TX_RELAYER_URL=
META_TX_RELAYER_API_KEY=


# --- AI: mediator and case clerk ---------------------------
# Provider choice is not yet settled; keys are provisioned so
# the decision costs nothing later.
#
# These components read evidence and propose a percentage.
# They are never given a credential or tool that can move
# funds — see CLAUDE.md.
ANTHROPIC_API_KEY=
MEDIATOR_MODEL=


# --- Runtime -----------------------------------------------
PORT=3000

# Public HTTPS origin of the deployed webhook receiver.
# Ship24 posts tracking events here, so it must be reachable
# from the internet — not a local tunnel.
PUBLIC_BASE_URL=
